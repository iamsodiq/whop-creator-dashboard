generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id             String   @id @default(cuid())
  transactionId  String
  productName    String
  amount         Float
  type           String   // "purchase" or "refund"
  date           DateTime @default(now())
  customerName   String
}

model Member {
  id         String   @id @default(cuid())
  name       String
  joinDate   DateTime @default(now())
  status     String   // "active" or "churned"
}

model Refund {
  id        String   @id @default(cuid())
  reason    String
  amount    Float
  date      DateTime @default(now())
}
